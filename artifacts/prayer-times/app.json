{
  "expo": {
    "name": "مواقيت الصلاة",
    "slug": "prayer-times",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prayer-times",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F4F5EF"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يُستخدم موقعك لحساب مواقيت الصلاة واتجاه القبلة بدقة."
      }
    },
    "android": {
      "package": "com.jaziriyassine.prayertimes",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يُستخدم موقعك لحساب مواقيت الصلاة واتجاه القبلة بدقة."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "sounds": [
            "./assets/sounds/ahmed_al_imadi.mp3",
            "./assets/sounds/majed_al_hamathani.mp3",
            "./assets/sounds/mokhtar_hadj_slimane.mp3",
            "./assets/sounds/nasser_al_qatami.mp3"
          ]
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "63f8b99e-d897-4e44-8eb7-121267de225d"
      }
    },
    "owner": "yassine_2011"
  }
}
